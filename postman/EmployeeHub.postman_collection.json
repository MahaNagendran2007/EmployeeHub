{
  "info": {
    "name": "EmployeeHub API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run 'Create employee' first; it stores employeeId for the other requests."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "employeeId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Create employee",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeCode\": \"EMP-2001\",\n  \"fullName\": \"Priya Sharma\",\n  \"email\": \"priya.sharma@example.com\",\n  \"department\": \"Engineering\",\n  \"jobTitle\": \"Software Engineer\",\n  \"location\": \"Chennai\",\n  \"phone\": \"+91 98765 43210\",\n  \"joiningDate\": \"2024-07-01\",\n  \"employmentStatus\": \"ACTIVE\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created',()=>pm.response.to.have.status(201));",
              "if(pm.response.code===201){pm.collectionVariables.set('employeeId',pm.response.json().id);}"
            ]
          }
        }
      ]
    },
    {
      "name": "Create employee - validation error (400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeCode\": \"x\",\n  \"fullName\": \"\",\n  \"email\": \"nope\",\n  \"department\": \"\",\n  \"jobTitle\": \"\",\n  \"location\": \"\",\n  \"joiningDate\": null,\n  \"employmentStatus\": null\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create employee - duplicate (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/employees",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"employeeCode\": \"EMP-2001\",\n  \"fullName\": \"Priya Sharma\",\n  \"email\": \"priya.sharma@example.com\",\n  \"department\": \"Engineering\",\n  \"jobTitle\": \"Software Engineer\",\n  \"location\": \"Chennai\",\n  \"phone\": \"+91 98765 43210\",\n  \"joiningDate\": \"2024-07-01\",\n  \"employmentStatus\": \"ACTIVE\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 on second run',()=>pm.expect([201,409]).to.include(pm.response.code));"
            ]
          }
        }
      ]
    },
    {
      "name": "List employees (paged)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees?page=0&size=10&sortBy=createdAt&direction=desc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ],
          "query": [
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "10"
            },
            {
              "key": "sortBy",
              "value": "createdAt"
            },
            {
              "key": "direction",
              "value": "desc"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Search and filter",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees?search=priya&department=Engineering&location=Chennai&status=ACTIVE",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees"
          ],
          "query": [
            {
              "key": "search",
              "value": "priya"
            },
            {
              "key": "department",
              "value": "Engineering"
            },
            {
              "key": "location",
              "value": "Chennai"
            },
            {
              "key": "status",
              "value": "ACTIVE"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get employee by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees/{{employeeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "{{employeeId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Get employee - not found (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/employees/000000000000000000000000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "000000000000000000000000"
          ]
        }
