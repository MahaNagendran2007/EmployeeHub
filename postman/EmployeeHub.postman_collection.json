          "raw": "{{baseUrl}}/api/employees/not-an-id",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "employees",
            "not-an-id"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400',()=>pm.response.to.have.status(400));"
