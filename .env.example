# Spring Boot does NOT read .env files by itself: set these in your shell (see README). Never commit real values.

# --- Database ---
MONGODB_URI=mongodb://localhost:27017/employeehub

# --- Server ---
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# --- Security (required for a real deployment) ---
# Signing key for login tokens: at least 32 random characters. If empty, a random key is generated at startup
# (everyone is signed out whenever the backend restarts).
EMPLOYEEHUB_JWT_SECRET=
EMPLOYEEHUB_JWT_TTL_MINUTES=60

# --- First administrator (used ONLY when the users collection is empty; remove the password afterwards) ---
EMPLOYEEHUB_ADMIN_USERNAME=admin
EMPLOYEEHUB_ADMIN_PASSWORD=

# --- Optional: insert sample employees into an EMPTY database (development only) ---
# SPRING_PROFILES_ACTIVE=demo
